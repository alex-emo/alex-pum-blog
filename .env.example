# 站点
SITE_NAME=Pum 的博客
SITE_DESCRIPTION=记录技术、折腾与日常。
SITE_URL=https://blog.pum.org.cn
SITE_AUTHOR=Pum
SITE_TIMEZONE=Asia/Shanghai

# 数据库与媒体目录（相对路径按项目根目录解析）
# DATABASE_URL=sqlite:////srv/blog/blog.db
MEDIA_DIR=media

# 安全：务必替换成随机值  python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
# 生产环境走 HTTPS 时改成 1，否则浏览器不会发送登录 cookie
COOKIE_SECURE=1
SESSION_MAX_AGE=1209600

# 首次启动自动建管理员（建好后建议删掉这两行）
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 站点行为
PAGE_SIZE=10
COMMENT_REQUIRE_APPROVAL=1
COMMENT_RATE_SECONDS=60
COMMENT_RATE_PER_HOUR=10
UPLOAD_MAX_BYTES=10485760
DEBUG=0
