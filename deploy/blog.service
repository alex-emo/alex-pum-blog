[Unit]
Description=Pum 的博客（FastAPI + Uvicorn）
Documentation=https://blog.pum.org.cn
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=blog
Group=blog
WorkingDirectory=/srv/blog
EnvironmentFile=/srv/blog/.env
# 单 worker：SQLite 写入必须串行，多 worker 只会互相锁
ExecStart=/srv/blog/venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8010 \
    --workers 1 \
    --proxy-headers \
    --forwarded-allow-ips=127.0.0.1 \
    --no-server-header \
    --log-level warning
Restart=always
RestartSec=3
TimeoutStopSec=15

# ---- 基础加固 ----
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/blog
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
UMask=0027
# 1G 内存的机器上留点余量
MemoryMax=512M

[Install]
WantedBy=multi-user.target
